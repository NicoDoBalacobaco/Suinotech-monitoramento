# ─────────────────────────────────────────────
# Configuração do servidor SuinoTech
# Copie este arquivo para ".env" (cp .env.example .env)
# ─────────────────────────────────────────────

# Porta em que o site + API vão rodar
PORT=3000

# Não existe mais configuração de porta serial aqui — a conexão com o
# Arduino é feita direto pelo navegador (Chrome/Edge), clicando no botão
# "Conectar Arduino (USB)" dentro do próprio site. Veja o README da pasta
# hardware/ para os detalhes.
